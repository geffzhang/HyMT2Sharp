<Project>
  <!--
    Independent NuGet versions. Edit here (and keep build/00-common.linq in sync).
    `dotnet pack -p:Version=` must not flow into referenced projects; see Directory.Build.targets.
  -->
  <PropertyGroup>
    <HyMT2SharpGgufVersion Condition="'$(HyMT2SharpGgufVersion)' == ''">1.0.0</HyMT2SharpGgufVersion>
    <HyMT2SharpKernelsVersion Condition="'$(HyMT2SharpKernelsVersion)' == ''">1.0.0</HyMT2SharpKernelsVersion>
    <HyMT2SharpModelVersion Condition="'$(HyMT2SharpModelVersion)' == ''">1.0.0</HyMT2SharpModelVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <Authors>sdcb</Authors>
    <Company>Sdcb</Company>
    <PackageProjectUrl>https://github.com/sdcb/HyMT2Sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sdcb/HyMT2Sharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>Sdcb;HyMT2;Hy-MT2;GGUF;LLM;translation</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryType>git</PublishRepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'HyMT2Sharp.Gguf'">
    <Version>$(HyMT2SharpGgufVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>GGUF v2/v3 reader aligned to ggml tensor offsets.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'HyMT2Sharp.Kernels'">
    <Version>$(HyMT2SharpKernelsVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>AVX2/AVX-VNNI Q4_K / Q2_0C / STQ1_0 panel GEMM and GEMV kernels.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'HyMT2Sharp.Model'">
    <Version>$(HyMT2SharpModelVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Hy-MT2 hunyuan-dense CPU inference: load GGUF, tokenize, KV cache and Forward.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
</Project>

